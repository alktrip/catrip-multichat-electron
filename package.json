{
  "name": "catrip_multichat_electron",
  "productName": "catrip_multichat_electron",
  "private": true,
  "version": "0.0.0",
  "description": "Catrip Multichat rewrite in Electron",
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:preload": "tsc -p tsconfig.preload.json --watch",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev": "node _scripts/kill-dev-port.js && concurrently -k \"npm:dev:renderer\" \"npm:dev:preload\" \"npm:dev:main\" \"npm:dev:electron\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build": "npm run build:renderer && npm run build:preload && npm run build:main",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "dbus-next": "^0.10.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "systray2": "^2.1.4"
  },
  "build": {
    "appId": "com.catrip.catrip-multichat-electron",
    "productName": "catrip_multichat_electron",
    "files": [
      "dist/**/*",
      "assets/icons/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;Chat;InstantMessaging;"
    }
  }
}
