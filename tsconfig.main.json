{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022"],
    "types": ["node"],
    "sourceMap": true
  },
  "include": [
    "src/main",
    "src/shared/i18n/types.ts",
    "src/shared/i18n/localeMeta.ts",
    "src/shared/i18n/loadLocaleResources.ts"
  ]
}
